generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String
  // PII fields: gated server side by the policy declared in app manifests.
  phone        String?
  nationalId   String?
  passwordHash String?
  createdAt    DateTime @default(now())

  accessRequests AccessRequest[]
}

/// Platform-level approvable resource. Used by the demo app to exercise the
/// approval action; apps declare their own resources.
model AccessRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  requestedRole String
  reason      String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

/// Owned by the feature-flags app module (src/apps/feature-flags).
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String
  name           String
  description    String
  environment    String
  enabled        Boolean  @default(false)
  owner          String
  lastModifiedBy String
  lastModifiedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([key, environment])
  @@index([environment, enabled])
  @@map("feature_flag")
}

/// KYC review queue (app: kyc-review). `customerName`, `documentNumber` and
/// `dateOfBirth` are PII; the policy lives in the app manifest.
model KycCase {
  id             String    @id @default(cuid())
  reference      String    @unique
  customerName   String
  documentNumber String
  dateOfBirth    DateTime
  country        String
  status         String    @default("pending")
  riskLevel      String
  riskNotes      String
  submittedAt    DateTime  @default(now())
  decidedAt      DateTime?
  decidedByEmail String?
  decisionNote   String?

  documents KycDocument[]

  @@index([status, riskLevel])
}

model KycDocument {
  id         String   @id @default(cuid())
  caseId     String
  case       KycCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind       String
  fileName   String
  issuer     String
  uploadedAt DateTime @default(now())

  @@index([caseId])
}

/// Append only. Enforced by database triggers (see migration) and by the fact
/// that the only write path in the application is `mutate()`.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String
  actorEmail String
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?

  @@index([resource, resourceId])
  @@index([actorId])
  @@map("audit_log")
}

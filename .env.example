DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public"
AUTH_SECRET="dev-secret-not-for-production"
AUTH_TRUST_HOST=true
# Local dev credentials provider. Disable in production.
ENABLE_DEV_CREDENTIALS=true
# Generic OIDC provider (optional in dev)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
